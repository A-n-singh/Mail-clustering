DATABASE_URL=sqlite:///./mail.db
TOKEN_KEY=
SESSION_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:5173
OWNER_EMAIL=you@gmail.com
# true = ANY Google account may sign in and gets their own mailbox database. false = only OWNER_EMAIL + ALLOWED_EMAILS (comma separated).
OPEN_SIGNUP=true
ALLOWED_EMAILS=
# at most this many accounts can sign up (the owner is always let in). Raise it when the server and Google allow more.
MAX_USERS=10
INITIAL_FETCH=1000
CLUSTER_CAP=360
USER_CAP=1000
BATCH_SIZE=25
TOPIC_MILESTONES=30,200,1000
SYNC_INTERVAL_MINUTES=20
ALLOW_PERMANENT_DELETE=false
TOPICS_ENABLED=true
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOPIC_MIN_CLUSTER_SIZE=8
RECLUSTER_DAYS=7
# Optional local models for topic headings (see README). Both empty = headings come from real subjects.
TITLE_MODEL_PATH=
TITLE_MIN_SIMILARITY=0.75
TITLE_MERGE_SIMILARITY=0.93
