# Copy to .env (deploy/init-env.sh does this and fills the two keys for you). Never commit .env.
DOMAIN=myinbox.duckdns.org
OAUTH_REDIRECT_URI=https://myinbox.duckdns.org/auth/callback
FRONTEND_URL=https://myinbox.duckdns.org

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=

# generated by init-env.sh, they never need to leave this machine
TOKEN_KEY=
SESSION_SECRET=

SYNC_INTERVAL_MINUTES=20
CLUSTER_CAP=360
ALLOW_PERMANENT_DELETE=false
